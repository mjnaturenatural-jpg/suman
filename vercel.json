{
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "regions": ["bom1"]
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sumantravels.online"
        }
      ],
      "destination": "https://www.sumantravels.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "http"
        }
      ],
      "destination": "https://www.sumantravels.online/:path*",
      "permanent": true
    }
  ]
}
