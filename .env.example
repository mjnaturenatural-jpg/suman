# Every environment variable read by the app. Copy to .env.local and fill in.
# NEVER commit real secrets — .env.local is gitignored.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin bootstrap
ADMIN_EMAIL=admin@sumantravels.com
ADMIN_PASSWORD=
# Secret header (x-admin-seed-secret) required by POST /api/seed
ADMIN_SEED_SECRET=

# Auth / security
JWT_SECRET=
# Bearer secret for POST /api/cron/*
CRON_SECRET=
# Header x-debug-events-secret required by POST /api/debug/checkout-event in production
DEBUG_EVENTS_SECRET=
# Secret for POST /api/revalidate
REVALIDATION_SECRET=

# Database (Turso / libsql; local SQLite file is used as fallback when unset)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Payments (Razorpay) — live keys live in the hosting provider's env settings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MongoDB (reserved for future use — not wired into the app yet)
MONGODB_URI=

# Image hosting (Cloudinary). When CLOUDINARY_CLOUD_NAME is set, site images
# load from res.cloudinary.com; otherwise the local /public images are used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Google Sheets export
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# Test harness (tests/payment-flow.mjs)
TEST_BASE_URL=http://localhost:3103
